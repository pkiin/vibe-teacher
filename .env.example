# vibe-teacher 환경 변수 예시
# 이 파일을 .env 로 복사해 값을 채우세요:   cp .env.example .env && chmod 600 .env
# .env 는 .gitignore 에 들어 있어 저장소에 올라가지 않습니다.
# npm run dev / npm start 가 시작할 때 읽으며, 셸에 이미 설정된 환경변수가 .env 보다 우선합니다.

# ---- AI 분석 (선택) ----
# Anthropic API 키 (https://console.anthropic.com 에서 발급). 설정하면 "AI로 자세히 분석"이
# Anthropic API 로 동작하며 요청마다 과금됩니다.
# 비워 두면 이 서버에 로그인된 Claude Code CLI(claude)를 대신 쓰므로 키가 없어도 됩니다.
ANTHROPIC_API_KEY=

# OpenRouter API 키 (https://openrouter.ai/keys 에서 발급). 여러 회사의 모델을 한 키로 씁니다.
# 기본 모델은 무료 모델 라우터(openrouter/free)이고, 소스 설정에서 OpenRouter 의 모델 목록 중 고를 수 있습니다.
# 무료 모델도 키가 필요하며, 무료 모델의 공급자는 입력을 기록하거나 학습에 쓸 수 있습니다.
OPENROUTER_API_KEY=

# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급). 요청마다 과금됩니다.
OPENAI_API_KEY=

# AI 제공자 강제: auto | claude-cli | anthropic-sdk | openrouter | openai | none   (비우면 화면에서 고른 값, 기본 auto)
# VIBE_TEACHER_LLM_PROVIDER=

# ---- 서버 ----
# VIBE_TEACHER_PORT=8787
# VIBE_TEACHER_HOST=127.0.0.1
# 127.0.0.1 이 아닌 주소로 열 때 필요한 접근 토큰 (긴 무작위 문자열)
# VIBE_TEACHER_TOKEN=
# 설정·캐시·위키 저장 위치
# VIBE_TEACHER_HOME=~/.vibe-teacher

# ---- 웹 개발 서버 (npm run dev) ----
# VIBE_TEACHER_WEB_PORT=5173
# VIBE_TEACHER_WEB_HOST=127.0.0.1
