# 개인 노트북에서 사용하기: cp .env.example .env && chmod 600 .env
# 연결 정보와 사용할 OpenRouter 키를 채운 뒤 npm install && npm run build && npm start
# 기본 접속 주소: http://127.0.0.1:3318 (화면과 API를 한 포트에서 제공)
# 개발자: docs/development.md / 공용 서버: docs/deployment.md / 전체 설정: docs/configuration.md

# 1. 회원 로그인 — 관리자가 안내한 같은 Supabase 프로젝트의 URL·공개 키 입력
# 직접 Supabase 프로젝트를 준비한다면 docs/authentication.md의 최초 설정 참고
VIBE_TEACHER_AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 2. AI 키 — 관리자가 제공한 OpenRouter 키 입력. 제공받지 못했다면 본인이 발급한 키 사용
# 기록 조회만 할 때는 비워도 됨
OPENROUTER_API_KEY=
VIBE_TEACHER_LLM_PROVIDER=openrouter
# 로그인된 Claude CLI를 쓰려면 auto, 새 AI 생성을 끄려면 none으로 변경

# 3. 실행 위치 — local은 내 기기의 기록을 읽는 회원 모드 (회원 데이터는 Supabase에 저장)
# 코드를 수정하는 개인 개발 환경도 local 유지. HTTPS 공용 서버는 shared, SSH 터널 서버는 ssh
VIBE_TEACHER_DEPLOYMENT=local

# 4. npm start의 기본 주소·포트 — 포트가 겹치면 여기서 변경하고 서버 재시작
# VIBE_TEACHER_PORT는 npm run dev에서는 API 포트로 사용
VIBE_TEACHER_HOST=127.0.0.1
VIBE_TEACHER_PORT=3318

# 5. 인증 후 복귀 주소 — 기본은 접속한 웹 주소를 사용하므로 주석 유지
# 주소·포트를 바꾸면 실제 웹 주소를 Supabase Redirect URLs에도 등록
# 고정할 때만 주석 해제. 개발은 http://127.0.0.1:3317/, shared는 실제 HTTPS 주소로 변경
# VIBE_TEACHER_PUBLIC_URL=http://127.0.0.1:3318/

# 6. 코드를 수정할 때만 사용하는 웹 개발 서버 (npm run dev)
# npm run build && npm start에는 아래 웹 개발 서버 주소·포트가 적용되지 않음
VIBE_TEACHER_WEB_HOST=127.0.0.1
VIBE_TEACHER_WEB_PORT=3317
# 개발 API 프록시는 VIBE_TEACHER_PORT를 자동으로 따름. 별도 대상이 필요할 때만 지정
# VIBE_TEACHER_API_URL=http://127.0.0.1:3318
