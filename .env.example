# 로컬 사용자 설정: cp .env.example .env && chmod 600 .env
# 설치 순서·공용 서버 운영: README.md의 "환경파일 구성" 참고

# 1. 회원 로그인 — 관리자가 안내한 같은 Supabase 프로젝트의 값 입력
VIBE_TEACHER_AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 2. 내 AI 키 — 발급받은 OpenRouter 키 입력
OPENROUTER_API_KEY=
VIBE_TEACHER_LLM_PROVIDER=openrouter
# Claude CLI 로그인을 쓰려면 위 provider를 auto로 변경

# 3. 실행 위치 — 내 노트북: local / HTTPS 공용 서버: shared
VIBE_TEACHER_DEPLOYMENT=local

# 4. 실행 포트 — 프론트 / 백엔드
VIBE_TEACHER_WEB_PORT=3317
VIBE_TEACHER_PORT=3318
# 선택: 인증 후 복귀 주소 고정 (Supabase Redirect URLs에도 등록)
# VIBE_TEACHER_PUBLIC_URL=http://127.0.0.1:3317/
