# vibe-teacher 환경 변수 예시
# 이 파일을 .env 로 복사해 값을 채우세요:   cp .env.example .env && chmod 600 .env
# .env 는 .gitignore 에 들어 있어 저장소에 올라가지 않습니다.
# npm run dev / npm start 가 시작할 때 읽으며, 셸에 이미 설정된 환경변수가 .env 보다 우선합니다.

# ---- AI 생성 ----
# 일반 설명은 로그인된 Claude CLI를 우선 사용합니다.
# CLI 실패·외부 문서 검색·API 생성은 모두 OpenRouter를 사용합니다.
# https://openrouter.ai/keys 에서 발급. 기본 모델: openai/gpt-5-mini
OPENROUTER_API_KEY=

# AI 제공자: auto | claude-cli | openrouter | none
# 예전 openai / anthropic-sdk 설정도 OpenRouter로 처리합니다.
# VIBE_TEACHER_LLM_PROVIDER=

# ---- 장기 기억 검색 ----
# 기본 mem0 OSS: 기억·벡터 DB는 PostgreSQL + pgvector, 기억 정리·임베딩은 위 OpenRouter 키를 사용합니다.
# npm run memory:db가 로컬 PostgreSQL을 Docker로 실행하고 아래 접속 URL·암호를 .env에 자동 저장합니다.
# 기존 PostgreSQL을 쓰면 pgvector 확장을 준비하고 URL만 지정하세요. 별도 메모리 구독·로컬 모델은 필요 없습니다.
# Supabase를 쓰면 전용 변수가 로컬 DB 주소보다 우선합니다. Connect → Session pooler(5432) URI를 복사하세요.
# VIBE_TEACHER_SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# 일반 PostgreSQL 또는 로컬 DB 접속 주소
# VIBE_TEACHER_MEMORY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
# Supabase API·인증 확장용 설정 (현재 mem0 SQL 접속에는 위 DB 주소를 사용)
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# 서버 전용: 브라우저 설정(VITE_*)에 넣지 마세요.
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# 로컬 Docker DB 포트와 암호 (암호 미지정 시 memory:db가 생성). 접속 주소는 127.0.0.1로 한정합니다.
# VIBE_TEACHER_POSTGRES_PORT=55432
# VIBE_TEACHER_POSTGRES_PASSWORD=
# OpenRouter API 사용료는 발생합니다.
# POST 학습 활동 뒤 최신 기록을 자동 색인합니다. 예전 기록은 내 기억 검색의 "기억 인덱스 업데이트"로 반영합니다.
# 키·DB 주소가 없거나 DB 연결에 실패하면 원장의 키워드 검색을 사용합니다. API 호출을 끄려면 local로 설정하세요.
# VIBE_TEACHER_MEMORY_BACKEND=mem0
# 기억 정리 모델만 따로 지정할 때 사용 (미지정이면 화면에서 설정한 OpenRouter 모델, 기본 openai/gpt-5-mini)
# VIBE_TEACHER_MEMORY_MODEL=openai/gpt-5-mini
# Supermemory 클라우드를 별도로 선택할 때만 다음을 설정합니다.
# VIBE_TEACHER_MEMORY_BACKEND=supermemory
# SUPERMEMORY_API_KEY=

# ---- 서버 ----
# VIBE_TEACHER_PORT=8787
# VIBE_TEACHER_HOST=127.0.0.1
# 127.0.0.1 이 아닌 주소로 열 때 필요한 접근 토큰 (긴 무작위 문자열)
# VIBE_TEACHER_TOKEN=
# 설정·캐시·위키 저장 위치
# VIBE_TEACHER_HOME=~/.vibe-teacher

# ---- 웹 개발 서버 (npm run dev) ----
# VIBE_TEACHER_WEB_PORT=5173
# VIBE_TEACHER_WEB_HOST=127.0.0.1
