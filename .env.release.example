# Windows 배포 묶음(npm run package)에 넣을 공개 설정입니다. 관리자만 씁니다.
#   cp .env.release.example .env.release
# 공개해도 되는 두 값만 적습니다. OpenRouter 키·secret 키·DB 주소를 적으면 묶음을 만들지 않습니다.
# 실제 값이 든 .env.release 와 만든 zip 은 저장소에 올리지 말고 참가자에게 직접 전달하세요.

# Supabase 프로젝트 주소 (Project Settings → API)
SUPABASE_URL=
# publishable 키 (sb_publishable_…) 또는 예전 anon 키
SUPABASE_PUBLISHABLE_KEY=
