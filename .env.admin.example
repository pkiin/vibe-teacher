# 관리자 설정이 필요할 때만: cp .env.admin.example .env.admin && chmod 600 .env.admin
# 개인 노트북 사용자·일반 개발자는 이 파일 없이 .env의 OPENROUTER_API_KEY에 관리자 제공 키 입력
# 제공받지 못했다면 본인이 발급한 키 사용
# 기본값은 관리자 키 없음·회원별 키 없음. 서버를 띄우는 것만으로 관리자 권한이 생기지 않음
# 관리자 회원 권한: docs/authentication.md / 공용 서버 운영·키 관리: docs/deployment.md
# 실제 키와 DB 주소를 채운 .env.admin은 공유·커밋 금지. 변경 후 API 서버 재시작

# 1. 관리자 본인의 AI 키 (선택)
# local: .env의 OPENROUTER_API_KEY가 없고 로그인한 회원이 관리자일 때 사용
# shared·ssh: 관리자 UUID의 회원별 키가 없을 때 관리자에게만 적용
# 다른 일반 회원에게 이 키가 공통으로 배포되지 않음
VIBE_TEACHER_ADMIN_OPENROUTER_API_KEY=

# 2. shared·ssh 회원별 AI 키 — 개인 노트북·개인 개발에서는 {} 유지
# 회원 관리의 "API 키 연결용 사용자 ID"(Supabase UUID): 해당 회원이 사용할 OpenRouter 키
# 관리자가 제공한 키를 연결하고, 제공하지 않는 경우 회원이 직접 발급한 키를 연결
# 회원 승인과 별개로 등록해야 함. 이메일을 키로 사용하지 않음
# ssh만: 가입 전이면 OS 계정 이름(예: "user99")으로 미리 등록 가능. 그 계정으로 터널을 연 회원이 사용 (UUID 등록 우선)
# 여러 명을 등록하는 JSON 예시는 docs/deployment.md의 "공용 서버의 사용자별 API 키"·"OS 계정 이름으로 미리 등록하기 (ssh)" 참고
VIBE_TEACHER_USER_OPENROUTER_KEYS={}

# 3. 관리자 DB 접속 (선택) — SQL Editor로 최초 설정했다면 일반 실행에는 불필요
# npm run accounts:setup / npm run cloud:inspect 또는 기존 mem0 SQL 접속용 Session pooler URI
# 사용자의 .env·브라우저에 전달하지 않음. DB 암호의 특수문자는 URL 인코딩
# VIBE_TEACHER_SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres
