# 관리자·개발 서버 전용: cp .env.admin.example .env.admin && chmod 600 .env.admin
# 일반 로컬 사용자는 이 파일 없이 .env에 본인 키를 입력합니다. 이 파일은 공유 금지

# 1. 관리자 개발용 AI 키 — 로컬 개인 키가 없거나 공용 서버의 관리자 계정일 때 사용
VIBE_TEACHER_ADMIN_OPENROUTER_API_KEY=

# 2. 공용 서버의 사용자별 키 — Supabase 사용자 UUID: OpenRouter 키 (JSON)
# 여러 명을 등록하는 예시는 README의 "공용 서버의 사용자별 API 키" 참고
VIBE_TEACHER_USER_OPENROUTER_KEYS={}

# 3. 관리자 DB 접속 — accounts:setup 또는 기존 mem0 SQL 접속에서만 필요
# VIBE_TEACHER_SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres
