# 관리자 공용 서버 전용. cp .env.admin.example .env.admin && chmod 600 .env.admin
# 일반 사용자의 .env나 다운로드 자료에 포함하지 마세요. VITE_* 변수로 만들지 마세요.
# 우선순위: 셸 환경변수 > .env > .env.admin. 서버 프로세스만 .env.admin을 읽습니다.

# 승인된 회원의 공용 서버 AI 요청에 사용합니다. 사용자에게 키를 반환하는 API는 없습니다.
OPENROUTER_API_KEY=

# 기존 비회원/홈 토큰 방식에서 mem0를 사용할 때만 필요합니다.
# Supabase 회원 모드의 저장·검색에는 관리자 DB 주소나 비밀 키가 필요하지 않습니다.
# VIBE_TEACHER_SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# VIBE_TEACHER_MEMORY_DATABASE_URL=
